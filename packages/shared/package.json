{
  "name": "@terms/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Terms contracts: zod schemas for every endpoint, SSE events, enums, money and rate maths, deal states and pure policy checks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@terms/source": "./src/index.ts",
