# Terms environment variables.
# Copy to .env for local development. Never commit .env.
# Server-only values must never be exposed to the browser; only VITE_* values reach the frontend.

# --- PayPal (server only) ---
# REST app owned by the "Maya Studio" sandbox business account.
# Create at https://developer.paypal.com/dashboard/applications/sandbox
# Enable: Invoicing, Vault, Transaction Search, Webhooks.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live (the demo always runs on sandbox)
PAYPAL_ENV=sandbox
# ID of the webhook registered for APP_BASE_URL/api/webhooks/paypal (scripts register it and print the ID)
PAYPAL_WEBHOOK_ID=
# Set to 1 to run tests that call the PayPal sandbox (requires the credentials above)
PAYPAL_SANDBOX_TESTS=0

# --- Database ---
# Local: docker compose up -d postgres
DATABASE_URL=postgresql://terms:terms@localhost:5432/terms
# Integration tests use a separate database created by scripts/db/init-test-db.sql
TEST_DATABASE_URL=postgresql://terms:terms@localhost:5432/terms_test

# --- AI (server only) ---
# Provider for the Vercel AI SDK: anthropic | openai | google
# (the hosted demo uses google with gemini-3.5-flash-lite for both models; docs/ai.md)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Negotiators, goal parser and reply parser
LLM_MODEL=claude-sonnet-5-5
# Explanations and message drafting
LLM_MODEL_FAST=claude-haiku-5-5
# live: call the provider | record: call it and save each answer | replay: use saved answers
# (replay needs no key: CI and the seeded demo can run the AI roles from recordings)
AI_MODE=live
AI_FIXTURE_DIR=apps/api/test/fixtures/ai
# deterministic: negotiate with the standard strategies and plain notes even with a key set
AI_NEGOTIATION=ai

# --- Frontend ---
# AG Grid Enterprise licence key (designed to be public; it ships in the browser bundle)
VITE_AG_GRID_LICENSE_KEY=
# Development only: serve mocks generated from packages/shared schemas. Never true in production builds.
VITE_USE_MOCKS=false

# --- App ---
# Public base URL of the deployed app (webhooks, offer links, PayPal return URLs)
APP_BASE_URL=http://localhost:3000
PORT=3000
# Random 32+ byte secrets, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=
OFFER_TOKEN_SECRET=
