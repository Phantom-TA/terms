{
  "name": "@terms/api",
  "version": "1.0.0",
  "private": true,
  "description": "Terms API: Express server, planner, deal engine, AI agents, PayPal integration and webhooks.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@terms/source src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@terms/shared": "workspace:*",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.2.0",
    "prisma": "~7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15"
  }
}
